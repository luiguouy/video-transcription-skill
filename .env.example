# Whisper 模型规格: tiny, base, small, medium, large-v3 (本地运行推荐 base 或 small)
WHISPER_MODEL_SIZE=base

# 计算设备: auto, cuda, cpu (auto 会优先检测显存并选择 cuda)
WHISPER_DEVICE=auto

# 计算精度: GPU 建议 float16, CPU 建议 int8 或 default
WHISPER_COMPUTE_TYPE=default

# 模型本地缓存目录（可选，默认使用系统缓存）
# WHISPER_MODEL_DIR=D:/models/whisper

# 下载与网络代理设置
DOWNLOAD_TIMEOUT=180
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 平台 Cookie 兼容策略（应对抖音/B站/YouTube平台风控）
# COOKIES_FROM_BROWSER 支持:
#   "auto" (默认值，自动依次探测 Edge、Chrome、Firefox，谁可用就用谁)
#   "edge,chrome" (支持自定义优先级列表)
#   "edge" 或 "chrome" (指定单一浏览器)
COOKIES_FROM_BROWSER=auto

# 也可手动指定导出的 cookies 文本文件路径
COOKIES_FILE_PATH=./cookies.txt

# 并发调度配置
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_DOWNLOADS=4
MAX_CONCURRENT_RENDERS=1
MAX_CONCURRENT_TRANSCRIBES=1
